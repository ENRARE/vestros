# Active frontend network: testnet (default) or mainnet
VITE_CHAIN_ENV=testnet

# Core Vestros contract addresses
VITE_USDC_VESTING_CONTRACT_TESTNET=0x8eae0cf6a7f8f8b6961315006c05ded1da8d8693
VITE_USDC_VESTING_CONTRACT_MAINNET=
VITE_USDC_VESTING_DEPLOY_TX_TESTNET=0x35bcde1c1d3fed9008db8267f0754dbc36f735f5e637c39b07a9c75e1e96741f
VITE_USDC_VESTING_DEPLOY_TX_MAINNET=
# Public post-deployment evidence only. Leave blank until the independently
# reviewed Mainnet runtime bytecode hashes are recorded.
VITE_MAINNET_USDC_VESTING_RUNTIME_CODE_HASH=
# Required for the operator preflight. Select only the approved release scope:
# factory, legacy, or factory,legacy.
MAINNET_RELEASE_COMPONENTS=

# Self-service factory deployment evidence. The factory address and deployment
# transaction are public; keep the approved runtime hash blank until the
# independent artifact/security review is complete.
VITE_VESTING_FACTORY_TESTNET=
VITE_VESTING_FACTORY_MAINNET=0xa9a60e3a9e46590CFcfa345c8F0e8b1E9039dc4d
VITE_VESTING_FACTORY_DEPLOY_TX_TESTNET=
VITE_VESTING_FACTORY_DEPLOY_TX_MAINNET=0x6891201cecc547d173eda6cac3833c9be7feac77b83130e8cdb5bc4b88eae9f2
VITE_MAINNET_VESTING_FACTORY_RUNTIME_CODE_HASH=

# GrantHub deployment records (Testnet only; verify each address before use)
VITE_GRANTHUB_FACTORY_TESTNET=0x0d12537B482Ad44BA4e03DA2444a97B903AA997B
VITE_GRANTHUB_FACTORY_MAINNET=
VITE_GRANTHUB_POOL_TESTNET=0x5C94F126AdFB09286524008CD1d74A03D29Fd5aD
VITE_GRANTHUB_VESTING_TESTNET=0x4d3B037Cb34359b0d6478d97c24fAbf414600c64
VITE_GRANTHUB_POOL_MAINNET=
VITE_GRANTHUB_VESTING_MAINNET=
VITE_GRANTHUB_FACTORY_DEPLOY_TX_TESTNET=0xa0c6d7401e01f263aa10dd51a92ce7ef0af0df561df263deadc34150a36e6e1e
VITE_GRANTHUB_POOL_DEPLOY_TX_TESTNET=0xd63239da52da3e01d4234973dae084c0ca03bf1000f2c049d7a2e22fb158b5f3
VITE_GRANTHUB_VESTING_DEPLOY_TX_TESTNET=0xeb304a8be645fe5227491bb3e481f3213ae4eac5c4b84f8fab25e68f36ab3a24
VITE_GRANTHUB_WIRING_TX_TESTNET=0x1c1ba167ee1043642c64bf882fa48c6e34b51e6dbb011378e87f2e632747fc49

# GrantHub money-moving features are disabled until explicitly authorized.
VITE_GRANTHUB_FINANCIAL=false
GRANTHUB_FINANCIAL_ENABLED=false

# Optional RPC proxy / server verification fallbacks
RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=Arc_Testnet,Arc
VITE_ARC_TESTNET_RPC=https://rpc.testnet.arc.io
# Optional public HTTPS fallback only; do not put API keys in VITE_* values.
VITE_ARC_TESTNET_RPC_FALLBACK=
# Server-only upstream for /api/rpc/arc-testnet; never embed this credential in browser code.
ARC_TESTNET_RPC_SECONDARY=
VITE_ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
VITE_ARC_MAINNET_RPC_FALLBACK=

# Server-side persistent vesting history indexer. Testnet only; never point
# these variables at Mainnet. Vault entries use address@firstSafeBlock@owner,
# with an optional verified creation transaction hash as the fourth field.
VESTING_INDEXER_ENABLED=true
VESTING_INDEXER_POLL_MS=120000
VESTING_INDEXER_MAX_BACKFILL_BLOCKS=300000
VESTING_INDEXER_OVERLAP_BLOCKS=2
# Optional verified source start blocks; deployment tx hashes are used when blank.
VESTING_INDEXER_CORE_START_BLOCK_TESTNET=
VESTING_INDEXER_FACTORY_START_BLOCK_TESTNET=
VESTING_INDEXER_VAULTS_TESTNET=
# Example: 0xVault@69890587@0xOwner@0xCreationTxHash

# Testnet-only raw-key deployment convenience. Do not set for mainnet.
# PRIVATE_KEY=
